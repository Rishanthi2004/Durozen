# Durozen Technologies Environment Configuration
# Template file: Copy to .env or .env.local and populate with your production values

# Google Apps Script Web App Deployment URL
# Used for Contact Inquiries and Careers Applications
# Deploy scripts/durozen-google-apps-script.js as a Web App:
# 1. Open Google Sheet -> Extensions -> Apps Script
# 2. Paste code from scripts/durozen-google-apps-script.js
# 3. Deploy -> New Deployment -> Select type: Web App
# 4. Execute as: Me | Who has access: Anyone
NEXT_PUBLIC_GOOGLE_SCRIPT_URL="https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec"

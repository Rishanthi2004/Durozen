# Durozen Technologies Environment Configuration
# Template file: Copy to .env or .env.local and populate with your production values

# Google Apps Script Web App Deployment URL (Optional for spreadsheet sync)
# Used for Contact Inquiries and Careers Applications
NEXT_PUBLIC_GOOGLE_SCRIPT_URL="https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec"

# SMTP & Recruitment Email Configuration (Nodemailer Backend for Career Applications)
# Recommended: Gmail App Password or company SMTP server
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="careers@durozen.in"
SMTP_PASS="your_smtp_app_password"
SMTP_FROM="\"Durozen Careers\" <careers@durozen.in>"
RECRUITMENT_EMAIL="sachinn2413@gmail.com"


